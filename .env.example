GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
SESSION_SECRET=replace-this-with-a-long-random-string

# Optional: set this to a persistent disk path when hosting on a normal Node server.
# Vercel uses temporary local storage and syncs app recall data to Google Drive.
DATA_DIR=./data

# Optional: put all created car folders inside an existing Drive folder.
# Use the folder ID from the Google Drive URL.
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Optional: name of the small JSON file used to remember invoices/jobs in Drive.
GOOGLE_DRIVE_STORE_FILE_NAME=Jazz Detailing App Data.json

# Optional invoice/email defaults.
BUSINESS_NAME=Your Detailing Business
BUSINESS_EMAIL=you@yourbusiness.com
BUSINESS_PHONE=
BUSINESS_ADDRESS=
INVOICE_COPY_EMAIL=you@yourbusiness.com
